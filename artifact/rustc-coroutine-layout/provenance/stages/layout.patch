+struct Zip<A, B> {
+    a: A,
+    b: B,
+}
+
+impl<A: thrust_models::Model, B: thrust_models::Model> thrust_models::Model for Zip<A, B> {
+    type Ty = (<A as thrust_models::Model>::Ty, <B as thrust_models::Model>::Ty);
